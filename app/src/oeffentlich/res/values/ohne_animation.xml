        <item name="android:taskToBackEnterAnimation">@anim/keine</item>
        <item name="android:taskToBackExitAnimation">@anim/keine</item>
        <item name="android:wallpaperOpenEnterAnimation">@anim/keine</item>
        <item name="android:wallpaperOpenExitAnimation">@anim/keine</item>
        <item name="android:wallpaperCloseEnterAnimation">@anim/keine</item>
        <item name="android:wallpaperCloseExitAnimation">@anim/keine</item>
        <item name="android:wallpaperIntraOpenEnterAnimation">@anim/keine</item>
